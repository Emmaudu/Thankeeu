# ===========================
# THANKEEU FRONTEND ENV VARS
# ===========================

VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Thankeeu
VITE_APP_URL=http://localhost:5173
VITE_APP_DOMAIN=thankeeu.com
VITE_WORKSPACE_BASE_URL=http://localhost:5173
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key

# ── Build-time only (used by scripts/generate-sitemap.js, not bundled) ──────
# Public site URL used as the base for every <loc> in sitemap.xml
APP_URL=https://thankeeu.com
# Backend base URL (no /api suffix) to fetch published blog post slugs from.
# Falls back to VITE_API_URL (stripping a trailing /api) if not set, then to
# https://api.thankeeu.com.
API_URL=https://api.thankeeu.com
