# ============================================================
# TASKEEU FRONTEND — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Your Railway backend URL (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Same backend URL for Socket.io
VITE_SOCKET_URL=http://localhost:5000

# Flutterwave public key (safe to expose in frontend)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_public_key
