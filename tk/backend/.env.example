# ===========================
# THANKEEU BACKEND ENV VARS
# ===========================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Admin — required to call /api/admin/run-auto-send for manual delivery testing
ADMIN_SECRET=set_a_long_random_string_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Paystack
# Flutterwave (replaces Paystack)
FLW_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
FLW_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
FLW_ENCRYPTION_KEY=FLWENCKEY-your_flutterwave_encryption_key
FLW_SECRET_HASH=your_custom_webhook_secret_hash

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=hello@thankeeu.com
EMAIL_FROM_NAME=Thankeeu

# Support
SUPPORT_EMAIL=support@thankeeu.com

# App
APP_NAME=Thankeeu
APP_URL=https://thankeeu.com
APP_DOMAIN=thankeeu.com
# Used to build redirect URLs like https://flutterwave.thankeeu.com after company signup.
# For local development, use http://localhost:5173 and visit http://demo.localhost:5173.
WORKSPACE_BASE_URL=https://thankeeu.com

# ─── Reloadly Gift Cards ─────────────────────────────────────────────────────
# Get these from https://app.reloadly.com → Settings → API Credentials
RELOADLY_CLIENT_ID=your_reloadly_client_id
RELOADLY_CLIENT_SECRET=your_reloadly_client_secret
# Set to "true" only after going LIVE on Reloadly dashboard
RELOADLY_LIVE=false

# FX rate: approximate NGN to USD (used for gift card amount conversion)
# Update this periodically or use a live FX API
NGN_TO_USD_RATE=1600

# GIPHY (GIF picker in card signing)
GIPHY_API_KEY=your_giphy_api_key_here
